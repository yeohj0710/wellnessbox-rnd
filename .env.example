# Core runtime settings
WB_RND_APP_ENV=staging
WB_RND_APP_NAME=wellnessbox-rnd
WB_RND_API_PREFIX=/v1
WB_RND_HOST=0.0.0.0
WB_RND_PORT=8000
WB_RND_LOG_LEVEL=INFO
WB_RND_WORKERS=1

# Backward-compatible alias still accepted by Settings.
# WB_RND_ENV=staging

# Provider-managed aliases that can be injected automatically.
# PORT=8000
# WEB_CONCURRENCY=1

# Interim PROXY_GOLD_SIMULATION integration
WB_RND_INTERIM_ENABLED=0
WB_RND_INTERIM_PACKAGE_DIR=C:/dev/wellnessbox_tips_interim_simulation_package
WB_RND_INTERIM_DATABASE=artifacts/tips/interim/interim.sqlite3

# Enforced staging/production deployment contract. Store the token in the provider secret store.
WB_RND_DEPLOYMENT_CONTRACT_ENFORCED=0
# WB_RND_DEPLOYMENT_TARGET=provider-service-name
# WB_RND_DEPLOYMENT_ID=provider-deployment-id
# WB_RND_CODE_COMMIT=0123456789abcdef0123456789abcdef01234567
# WB_RND_DATABASE_DURABILITY=provider_persistent_volume
# WB_RND_INTERNAL_AUTH_SCHEME=shared_header_hmac_sha256_v1
# WB_RND_INTERIM_INTERNAL_TOKEN=<provider-secret-minimum-32-bytes>

